            "url": "{{billingBaseUrl}}/api/v1/billing/orders/{{osId}}/budget",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"description\": \"Revisão demonstrativa\",\n      \"quantity\": 1,\n      \"unitPriceCents\": 10000\n    },\n    {\n      \"description\": \"Filtro demonstrativo\",\n      \"quantity\": 1,\n      \"unitPriceCents\": 5000,\n      \"pecaId\": \"{{pecaId}}\"\n    },\n    {\n      \"description\": \"Junta demonstrativa\",\n      \"quantity\": 1,\n      \"unitPriceCents\": 2500,\n      \"pecaId\": \"{{pecaBId}}\"\n    }\n  ],\n  \"groups\": [\n    {\n      \"title\": \"Revisão preventiva\",\n      \"items\": [\n        {\n          \"description\": \"Revisão demonstrativa\",\n          \"quantity\": 1,\n          \"unitPriceCents\": 10000\n        },\n        {\n          \"description\": \"Filtro demonstrativo\",\n          \"quantity\": 1,\n          \"unitPriceCents\": 5000,\n          \"pecaId\": \"{{pecaId}}\"\n        },\n        {\n          \"description\": \"Junta demonstrativa\",\n          \"quantity\": 1,\n          \"unitPriceCents\": 2500,\n          \"pecaId\": \"{{pecaBId}}\"\n        }\n      ]\n    }\n  ],\n  \"notasCliente\": \"Nota pública fictícia.\",\n  \"notasInternas\": \"Nota interna fictícia.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
