      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "mechanicToken",
      "value": ""
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "mecanicoId",
      "value": ""
    },
    {
      "key": "pecaId",
      "value": ""
    },
    {
      "key": "filialId",
      "value": "filial-sp"
    },
    {
