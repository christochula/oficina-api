      "value": ""
    },
    {
      "key": "numeroOS",
      "value": ""
    },
    {
      "key": "buscaPeca",
      "value": "filtro"
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "operationId",
      "value": ""
