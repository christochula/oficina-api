  "item": [
    {
      "name": "Consultas de catalogos e contratos por perfil",
      "item": [
        {
          "name": "Estoque - busca global por nome codigo descricao",
          "request": {
            "method": "GET",
            "description": "ADMIN ou MECANICO. Código é único por filial. Ativo com saldo zero continua selecionável para orçamento, mas pode impedir preparação.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/estoque?busca={{buscaPeca}}&filialId={{filialId}}&ativo=true&pagina=1&porPagina=20"
          }
        },
        {
          "name": "Veiculos - busca global por placa marca modelo",
          "request": {
            "method": "GET",
            "description": "",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/veiculos?busca=BRA&ativo=true&pagina=1&porPagina=20"
          }
        },
        {
          "name": "Servicos - busca global por nome descricao categoria",
          "request": {
            "method": "GET",
            "description": "",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/servicos-oficina?busca=revisao&ativo=true&pagina=1&porPagina=20"
          }
        },
        {
          "name": "OS - numero exato e filtros antes da pagina",
          "request": {
            "method": "GET",
            "description": "Número puro, #N ou OS N identifica a OS exata. Status opcional; texto encontra rótulos humanos. Busca não amplia ownership.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico?busca={{numeroOS}}&filialId={{filialId}}&pagina=1&porPagina=20"
          }
        },
        {
          "name": "OS - cliente titular com privacidade",
          "request": {
            "method": "GET",
            "description": "",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico/minhas/{{osId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json(); const order = body.data || body;",
                  "  pm.test('Cliente não recebe detalhes internos', function () {",
                  "    ['notasInternas','failure','faltasEstoque','consumosPeca'].forEach(key => pm.expect(order).not.to.have.property(key));",
                  "    if (order.orcamento) pm.expect(order.orcamento).not.to.have.property('notasInternas');",
                  "    if (order.budget) pm.expect(order.budget).not.to.have.property('notasInternas');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "OS - mecanico responsavel e saldos por OS",
          "request": {
            "method": "GET",
            "description": "consumosPeca mostra reservado/consumido/restante por OS; não é saldo global.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mechanicToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico/mecanico/{{osId}}"
          }
        },
        {
          "name": "OS - equipe e faltas de preparacao",
          "request": {
            "method": "GET",
            "description": "faltasEstoque identifica peça/filial/necessária/faltante/motivo. Consultor não recebe quantidadeDisponivel. Sucesso da preparação limpa faltas.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico/{{osId}}"
          }
        }
      ]
    },
    {
      "name": "Fachada OS - orcamento e consumo atuais",
      "item": [
        {
          "name": "OS - gerar orcamento com grupo e notas",
          "request": {
            "method": "PATCH",
            "description": "Total R$175. Identidade ativa de materiais/filial validada no servidor. GET da OS preserva grupo/notas e remove nota interna para cliente.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mechanicToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico/{{osId}}/orcamento",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grupos\": [\n    {\n      \"titulo\": \"Revisão preventiva\",\n      \"linhas\": [\n        {\n          \"tipo\": \"SERVICO\",\n          \"descricao\": \"Revisão demonstrativa\",\n          \"quantidade\": 1,\n          \"valorUnitario\": 100\n        },\n        {\n          \"tipo\": \"MATERIAL\",\n          \"descricao\": \"Filtro demonstrativo\",\n          \"quantidade\": 1,\n          \"valorUnitario\": 50,\n          \"pecaId\": \"{{pecaId}}\"\n        },\n        {\n          \"tipo\": \"MATERIAL\",\n          \"descricao\": \"Junta demonstrativa\",\n          \"quantidade\": 1,\n          \"valorUnitario\": 25,\n          \"pecaId\": \"{{pecaBId}}\"\n        }\n      ]\n    }\n  ],\n  \"notasCliente\": \"Conferir orçamento antes de aprovar.\",\n  \"notasInternas\": \"Nota fictícia restrita à equipe.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "OS - consumir com recibo duravel",
          "request": {
            "method": "PATCH",
            "description": "Preencha operationId com UUID novo por intenção. Resposta perdida: repita exatamente o mesmo ID e payload. Excesso: HTTP400 code=QUANTITY_EXCEEDS_RESERVATION definitive=true e quantidades; não houve consumo. Novo consumo exige outro UUID.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mechanicToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico/{{osId}}/consumo-peca",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{pecaId}}\",\n  \"quantidade\": 1,\n  \"operationId\": \"{{operationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('operationId')) throw new Error('Defina operationId (UUID) por intenção; preserve-o nas repetições.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 400) { const body = pm.response.json(); if (body.code === 'QUANTITY_EXCEEDS_RESERVATION') { pm.test('Excesso definitivo com saldo', function () { pm.expect(body.definitive).to.eql(true); ['quantidadeSolicitada','quantidadeReservada','quantidadeConsumida','quantidadeRestante'].forEach(key => pm.expect(body[key]).to.be.a('number')); }); } }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fluxo e participantes - executar individualmente em fixtures proprios",
      "item": [
        {
          "name": "OS - abrir",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{osBaseUrl}}/api/v1/ordens-servico",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"filialId\": \"{{filialId}}\",\n  \"problemasRelatados\": [\n    {\n      \"descricao\": \"Revisão demonstrativa\"\n    }\n  ],\n  \"servicosSolicitados\": [\n    {\n      \"servicoId\": \"{{servicoId}}\"\n    }\n  ],\n  \"pecasSolicitadas\": [\n    {\n      \"pecaId\": \"{{pecaId}}\",\n      \"quantidade\": 1\n    },\n    {\n      \"pecaId\": \"{{pecaBId}}\",\n      \"quantidade\": 1\n    }\n  ],\n  \"notasCliente\": \"Solicitação fictícia de revisão.\",\n  \"notasInternas\": \"Nota fictícia da abertura.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "ADMINISTRADOR. Remova servicosSolicitados se não usar catálogo. IDs vêm das buscas; validação rejeita peça inativa/outra filial. Duplicatas são somadas. Resposta persiste snapshots e não reserva estoque. CONSULTOR deve omitir peças solicitadas."
          }
        },
