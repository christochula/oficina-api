{
  "schemaVersion": 1,
  "purpose": "Metadata only for a fresh AWS homolog account using the existing GitHub, Sonar, Datadog and Mercado Pago accounts. This file is not input to configure-repositories.mjs.",
  "scope": {
    "githubOwner": "christochula",
    "githubEnvironment": "homolog",
    "awsAccountId": null,
    "awsRegion": "us-east-1",
    "environment": "homolog",
    "stateBucket": null,
    "kubernetesVersion": null,
    "clusterName": "oficina-homolog-eks",
    "namespace": "oficina-fase4",
    "roles": {
      "cluster": null,
      "node": null,
      "principal": null,
      "lambda": null
    }
  },
  "decisions": {
    "freshApplicationData": true,
    "deployLegacyDatabase": false,
    "paymentMode": "mercado-pago-test",
    "datadogObservabilityMode": "agent-only",
    "existingDatadogState": {
      "bucket": null,
      "key": null,
      "owningAccountId": null
    },
    "cleanup": "Only after the new environment is accepted; preserve old states and retained data until separately reviewed."
  },
  "repositories": {
    "oficina-api": {
      "sourceRef": "feature/phase4-distributed",
      "targetSha": null,
      "enabled": true
    },
    "oficina-billing-service": {
      "sourceRef": "feature/aws-mercadopago-test",
      "targetSha": null,
      "enabled": true
    },
    "oficina-production-service": {
      "sourceRef": "feature/aws-mercadopago-test",
      "targetSha": null,
      "enabled": true
    },
    "oficina-auth-serverless": {
      "sourceRef": "feature/phase4-distributed",
      "targetSha": null,
      "enabled": true
    },
    "oficina-infra-kubernetes": {
      "sourceRef": "feature/phase4-distributed",
      "targetSha": null,
      "enabled": true
    },
    "oficina-infra-database": {
      "sourceRef": "feature/phase4-distributed",
      "targetSha": null,
      "enabled": false
    }
  },
  "states": [
    {
      "repository": "oficina-infra-kubernetes",
      "directory": "aws",
      "key": "oficina/kubernetes/terraform.tfstate",
      "enabled": true,
      "ownership": "new AWS account; never migrate old-account resource state"
    },
    {
      "repository": "oficina-infra-kubernetes",
      "directory": "observability",
      "key": "oficina/observability/terraform.tfstate",
      "enabled": false,
      "ownership": "existing canonical Datadog state; do not initialize a second owner"
    },
    {
      "repository": "oficina-api",
      "directory": "infra",
      "key": "oficina-fase4/os/terraform.tfstate",
      "enabled": true,
      "ownership": "new AWS account; never migrate old-account resource state"
    },
    {
      "repository": "oficina-billing-service",
      "directory": "infra",
      "key": "oficina-fase4/billing/terraform.tfstate",
      "enabled": true,
      "ownership": "new AWS account; never migrate old-account resource state"
    },
    {
      "repository": "oficina-production-service",
      "directory": "infra",
      "key": "oficina/production/terraform.tfstate",
      "enabled": true,
      "ownership": "new AWS account; never migrate old-account resource state"
    },
    {
      "repository": "oficina-auth-serverless",
      "directory": "terraform",
      "key": "oficina/auth/terraform.tfstate",
      "enabled": true,
      "ownership": "new AWS account; never migrate old-account resource state"
    },
    {
      "repository": "oficina-infra-database",
      "directory": ".",
      "key": "oficina/database/terraform.tfstate",
      "enabled": false,
      "ownership": "new AWS account; never migrate old-account resource state"
    }
  ],
  "bindings": [
    {
      "kind": "environmentSecret",
      "names": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN"
      ],
      "destinations": [
        "oficina-api",
        "oficina-billing-service",
        "oficina-production-service",
        "oficina-auth-serverless",
        "oficina-infra-kubernetes"
      ],
      "source": "Fresh temporary session of scope.awsAccountId; copy the complete triple through the approved secret channel. Never copy previous-account credentials.",
      "stage": "before-each-session"
    },
    {
      "kind": "repositorySecret",
      "names": [
        "SONAR_TOKEN"
      ],
      "destinations": [
