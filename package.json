{
  "name": "oficina-api",
  "version": "3.0.0",
  "description": "API NestJS da oficina, executada em Kubernetes e instrumentada com Datadog",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.ts\"",
    "start": "node --require dd-trace/init ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --require dd-trace/init ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --require dd-trace/init dist/src/main",
    "lint": "eslint \"{src,apps,libs,test,prisma}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "seed": "ts-node prisma/seed.ts",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "seed:demo:validate": "ts-node prisma/seed-demo.ts --validate-only",
    "test:bdd": "cucumber-js test/phase4/features/*.feature --require test/phase4/steps.cjs --format progress --format json:bdd-report.json",
    "test:frontend:e2e": "playwright test -c test/phase4/playwright.config.cjs",
    "test:frontend:manual": "playwright test -c test/phase4/manual-playwright.config.cjs",
    "seed:local-demo": "node scripts/seed-local-demo.cjs",
    "local:up": "node scripts/local-phase4.cjs up",
    "local:dev": "node scripts/local-phase4.cjs dev",
    "local:stop": "node scripts/local-phase4.cjs stop",
    "local:status": "node scripts/local-phase4.cjs status",
    "test:local": "node scripts/local-phase4.cjs test",
    "test:video:local": "playwright test -c test/phase4/video-rehearsal-playwright.config.cjs",
    "test:resilience": "node --test test/phase4/resilience.cjs",
    "test:frontend:desktop": "playwright test -c test/phase4/desktop-playwright.config.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1123.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dd-trace": "^6.13.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "hot-shots": "^17.1.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.11.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!phase4/module.ts",
      "!main.ts",
      "!app.controller.ts",
      "!app.service.ts",
      "!ordem-servico/**",
      "!estoque/**",
      "ordem-servico/interfaces/http/v1/dtos/abrir-ordem-servico.dto.ts",
      "ordem-servico/interfaces/http/v1/dtos/gerar-orcamento.dto.ts",
      "ordem-servico/domain/value-objects/linha-servico.vo.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
