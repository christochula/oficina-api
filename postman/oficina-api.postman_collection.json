            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/iniciar-execucao",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{ordemServicoId}}", "iniciar-execucao"]
            }
          }
        }
      ]
    },
    {
      "name": "5.10B Alternativa - Webhook externo de orcamento",
      "item": [
        {
          "name": "1. Receber aprovacao ou recusa externa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-token", "value": "{{orcamentoWebhookToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"osId\": \"{{ordemServicoId}}\",\n  \"decisao\": \"APROVADO\",\n  \"origem\": \"postman-demo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/webhook/orcamento",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "webhook", "orcamento"]
            },
            "description": "Recebe uma notificacao externa de aprovacao ou recusa do orcamento. Use decisao APROVADO para avancar a OS para APROVADA ou RECUSADO para cancelar a OS. Requer x-webhook-token igual ao ORCAMENTO_WEBHOOK_TOKEN configurado no ambiente."
          }
        }
      ]
    },
    {
      "name": "5.12 Consumo de Peca",
      "item": [
        {
          "name": "1. Registrar consumo de peca (MECANICO)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mecanicoToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{pecaId}}\",\n  \"quantidade\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/consumo-peca",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{ordemServicoId}}", "consumo-peca"]
            }
          }
        }
      ]
    },
    {
      "name": "5.13 Finalizar e Entregar",
      "item": [
        {
          "name": "1. Finalizar OS (MECANICO)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mecanicoToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/finalizar",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{ordemServicoId}}", "finalizar"]
            }
          }
        },
        {
          "name": "2. Entregar veiculo (CONSULTOR)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{consultorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{ordemServicoId}}/entregar",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{ordemServicoId}}", "entregar"]
            }
          }
        }
      ]
    },
    {
      "name": "5.14 Relatorios",
      "item": [
        {
          "name": "1. Lead-time",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/relatorio/lead-time",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "relatorio", "lead-time"]
            }
          }
        },
        {
          "name": "2. KPIs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/relatorio/kpis",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "relatorio", "kpis"]
            }
          }
        },
        {
          "name": "3. Tempo de ciclo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/relatorio/tempo-ciclo?eventoInicio=MECANICO_ATRIBUIDO&eventoFim=ORDEM_FINALIZADA",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "relatorio", "tempo-ciclo"],
              "query": [
                { "key": "eventoInicio", "value": "MECANICO_ATRIBUIDO" },
                { "key": "eventoFim", "value": "ORDEM_FINALIZADA" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5.15 Listagem priorizada Fase 2",
      "item": [
        {
          "name": "1. Fila de OS (ADMIN/CONSULTOR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/fila",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "fila"]
            },
            "description": "Lista a fila operacional da Fase 2 com prioridade EM_EXECUCAO > AGUARDANDO_APROVACAO > EM_DIAGNOSTICO > RECEBIDA, OS mais antigas primeiro em cada status, excluindo FINALIZADA e ENTREGUE."
          }
        }
      ]
    },
    {
      "name": "Extra - Mecanico",
      "item": [
        {
          "name": "1. Minhas ordens (MECANICO)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mecanicoToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/mecanico/minhas-ordens",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "mecanico", "minhas-ordens"]
            }
          }
        },
        {
          "name": "2. Detalhe da minha OS (MECANICO)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mecanicoToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/mecanico/{{ordemServicoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "mecanico", "{{ordemServicoId}}"]
            }
          }
        }
      ]
    }
  ]
}
