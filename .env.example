# ── Aplicação ──────────────────────────────────────────────────────────────────
PORT=3000
PHASE4_ENABLED=true
SAGA_WORKER_ENABLED=true
SAGA_TIMEOUT_MS=60000
AWS_REGION=us-east-1
BILLING_SERVICE_URL=http://localhost:3001
PRODUCTION_SERVICE_URL=http://localhost:3002
AUTH_CLIENT_LOOKUP_TOKEN=troque_por_token_interno_com_pelo_menos_32_bytes
# AWS_ENDPOINT_URL=http://localhost:4566
INBOX_QUEUE_URL=
BILLING_QUEUE_URL=
PRODUCTION_QUEUE_URL=
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados ─────────────────────────────────────────────────────────────
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque_por_senha_local
POSTGRES_DB=oficina_db
POSTGRES_PORT=5432

# Utilizada pelo Prisma e pela aplicação — aponta para o serviço "db" do docker-compose
DATABASE_URL=postgresql://oficina:troque_por_senha_local@db:5432/oficina_db

# Para rodar a aplicação localmente (fora do Docker), troque "db" por "localhost":
# DATABASE_URL=postgresql://oficina:troque_por_senha_local@localhost:5432/oficina_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_um_segredo_forte_com_32_bytes
JWT_EXPIRATION=15m

JWT_REFRESH_SECRET=troque_por_outro_segredo_forte_com_32_bytes
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=oficina-auth-serverless
JWT_AUDIENCE=oficina-api

# ── Datadog / observabilidade ──────────────────────────────────────────────
# Em Kubernetes, DD_AGENT_HOST é injetado pelo Datadog Admission Controller.
DD_SERVICE=oficina-api
DD_ENV=local
DD_VERSION=dev
DD_SITE=datadoghq.com
DD_AGENT_HOST=127.0.0.1
DD_DOGSTATSD_PORT=8125
DD_TRACE_ENABLED=true
DD_TRACE_PROPAGATION_STYLE_INJECT=datadog,tracecontext
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_METRICS_ENABLED=true


# SQS queue URL created by oficina-auth-serverless.
NOTIFICATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/oficina-local-notifications
# ── Integracoes externas simuladas ───────────────────────────────────────────
ORCAMENTO_WEBHOOK_TOKEN=troque_por_token_webhook

# ── Seed do administrador ─────────────────────────────────────────────────────
# Senha usada pelo "npm run seed" para criar o primeiro admin.
# Se não definida, informe uma senha local forte ao executar o seed.
ADMIN_SEED_PASSWORD=troque_por_senha_local_forte
