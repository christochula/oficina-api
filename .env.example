# ── Aplicação ──────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Banco de dados ─────────────────────────────────────────────────────────────
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque_por_senha_local
POSTGRES_DB=oficina_db
POSTGRES_PORT=5432

# Utilizada pelo Prisma e pela aplicação — aponta para o serviço "db" do docker-compose
DATABASE_URL=postgresql://oficina:troque_por_senha_local@db:5432/oficina_db

# Para rodar a aplicação localmente (fora do Docker), troque "db" por "localhost":
# DATABASE_URL=postgresql://oficina:troque_por_senha_local@localhost:5432/oficina_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRATION=15m

JWT_REFRESH_SECRET=troque_por_outro_segredo_forte
JWT_REFRESH_EXPIRATION=7d

# ── Integracoes externas simuladas ───────────────────────────────────────────
ORCAMENTO_WEBHOOK_TOKEN=troque_por_token_webhook

# ── Seed do administrador ─────────────────────────────────────────────────────
# Senha usada pelo "npm run seed" para criar o primeiro admin.
# Se não definida, informe uma senha local forte ao executar o seed.
ADMIN_SEED_PASSWORD=troque_por_senha_local_forte