# Em produção, deixe as URLs vazias para usar o mesmo host do frontend.
VITE_API_BASE_URL=/api/v1
VITE_DEV_BILLING_TARGET=http://localhost:3001
VITE_DEV_PRODUCTION_TARGET=http://localhost:3002
VITE_CLIENT_AUTH_BASE_URL=

# Somente desenvolvimento: destinos usados pelo proxy do Vite.
VITE_DEV_API_TARGET=http://localhost:3000
VITE_DEV_AUTH_TARGET=http://localhost:3000

VITE_REQUEST_TIMEOUT_MS=15000

# Optional local browser demonstration. These settings belong only to Node/Vite;
# never rename them with VITE_ or use real production credentials here.
# Only `vite` development server supports this mode, never build/preview.
LOCAL_DEMO_MODE=false
# Uses the local OS API above; non-loopback targets stop the dev server.
# Defaults match test/phase4 fixtures. Override both only alongside the local OS.
# LOCAL_DEMO_JWT_SECRET=local-only-access-secret-32-bytes-minimum
# LOCAL_DEMO_INTERNAL_TOKEN=local-only-internal-token-32-bytes-minimum
# Example: put LOCAL_DEMO_MODE=true in ignored .env.local, then npm run dev.
# The opt-in plugin always binds 127.0.0.1 and accepts only local Host/Origin.
